{
  "name": "procurement-backend",
  "version": "1.0.0",
  "description": "Procurement System Backend API",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "audit:schema": "node scripts/auditRemediationMigration.js",
    "audit:schema:check": "node scripts/auditRemediationMigration.js --check",
    "workflow:schema": "node scripts/requestWorkflowMigration.js --schema",
    "workflow:inventory": "node scripts/requestWorkflowMigration.js --inventory",
    "test:workflows": "node scripts/testRequestWorkflows.js",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "setup-db": "node scripts/setupDatabase.js",
    "test": "cross-env NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit",
    "test:load": "node scripts/load-test.js"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "expo-server-sdk": "^7.2.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.0",
    "multer": "^1.4.5-lts.2",
    "mysql2": "3.12.0",
    "mysqldump": "^3.2.0",
    "nodemailer": "^9.1.1",
    "redis": "^6.3.0",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "cross-env": "^10.1.0",
    "jest": "^30.5.1",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  }
}
